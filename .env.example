# Meta / Instagram Graph API Configuration
# Get credentials from Meta for Developers (https://developers.facebook.com)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/auth/instagram/callback
INSTAGRAM_API_VERSION=v19.0

# Base URL used by Meta Graph API servers to fetch rendered reels for publishing.
# When running locally, expose your local port 8000 using ngrok, Cloudflare Tunnel, or localtunnel:
# e.g., https://your-tunnel-subdomain.ngrok-free.app
PUBLIC_MEDIA_BASE_URL=http://localhost:8000

# Database & Broker
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=instagram_autopilot
REDIS_URL=redis://localhost:6379/0

# Security & Encryption
# Generate key using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=gAAAAABmK7xL1_qF4J9X2W3e4r5t6y7u8i9o0p1a2s3d4f5g6h7j8k9l0z=
JWT_SECRET=super_secret_jwt_hmac_production_key_for_multi_tenant_workspace_2026

# Free-Tier AI & Stock Providers (Zero-Cost Mode)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
PEXELS_API_KEY=
PIXABAY_API_KEY=
ZERO_COST_MODE=true

# Operational Schedule
TIMEZONE=Asia/Kolkata
SLOT1_TIME=07:00
SLOT2_TIME=18:00
DAILY_REEL_LIMIT=2
MEDIA_STORAGE_DIR=./media_storage
